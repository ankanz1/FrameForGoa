{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/s/(.*)", "destination": "/api/index" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" }
  ]
}